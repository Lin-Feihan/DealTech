{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Merger Strategy Output Schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "status",
    "workflow_steps_integrated"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "workflow_steps_integrated": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "framework_reason": {
      "type": "string"
    },
    "final_output_path": {
      "type": "string"
    }
  }
}
