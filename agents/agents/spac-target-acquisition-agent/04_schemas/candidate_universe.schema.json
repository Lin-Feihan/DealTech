{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidate_universe",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "candidate_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "candidate_name": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "sector": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "sub_sector": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "business_description": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "public_or_private": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "geography": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "estimated_revenue_scale": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "estimated_ebitda_scale": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "evidence_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "source_replay_status": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "candidate_status": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "claim_class": {
      "enum": [
        "source-backed fact",
        "evidence-supported inference",
        "assumption",
        "unknown",
        "human_review_required"
      ]
    },
    "PCE_status": {
      "enum": [
        "Certified",
        "Certified with Caveat",
        "Needs Human Review",
        "Not Certified",
        "Human Review Required",
        "Internal Trace Only"
      ]
    },
    "human_review_required": {
      "type": [
        "boolean",
        "string",
        "null"
      ]
    }
  },
  "required": [
    "candidate_id",
    "candidate_name"
  ]
}
