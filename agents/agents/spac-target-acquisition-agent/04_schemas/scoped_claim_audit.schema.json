{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scoped_claim_audit",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "claim_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "claim_text": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "claim_type": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "PCE_status": {
      "enum": [
        "Certified",
        "Certified with Caveat",
        "Needs Human Review",
        "Not Certified",
        "Human Review Required",
        "Internal Trace Only"
      ]
    },
    "final_delivery_allowed": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "human_review_required": {
      "type": [
        "boolean",
        "string",
        "null"
      ]
    },
    "claim_class": {
      "enum": [
        "source-backed fact",
        "evidence-supported inference",
        "assumption",
        "unknown",
        "human_review_required"
      ]
    }
  },
  "required": [
    "claim_id",
    "claim_text"
  ]
}
