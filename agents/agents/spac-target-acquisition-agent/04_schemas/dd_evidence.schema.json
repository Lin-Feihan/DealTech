{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dd_evidence",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "evidence_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "candidate_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "diligence_area": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "extracted_fact": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "source_type": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "source_reliability_tier": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "evidence_strength": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "limitation": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "supports_claim_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "human_review_required": {
      "type": [
        "boolean",
        "string",
        "null"
      ]
    },
    "PCE_eligible": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "claim_class": {
      "enum": [
        "source-backed fact",
        "evidence-supported inference",
        "assumption",
        "unknown",
        "human_review_required"
      ]
    },
    "PCE_status": {
      "enum": [
        "Certified",
        "Certified with Caveat",
        "Needs Human Review",
        "Not Certified",
        "Human Review Required",
        "Internal Trace Only"
      ]
    }
  },
  "required": [
    "evidence_id",
    "candidate_id"
  ]
}
