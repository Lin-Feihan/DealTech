{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "buyer_profile",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "buyer_name": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "business_background": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "AI_strategy_relevance": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "financial_capacity": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "evidence_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "claim_class": {
      "enum": [
        "source-backed fact",
        "evidence-supported inference",
        "assumption",
        "unknown",
        "human_review_required"
      ]
    },
    "human_review_required": {
      "type": [
        "boolean",
        "string",
        "null"
      ]
    },
    "PCE_status": {
      "enum": [
        "Certified",
        "Certified with Caveat",
        "Needs Human Review",
        "Not Certified",
        "Human Review Required",
        "Internal Trace Only"
      ]
    }
  },
  "required": [
    "buyer_name",
    "business_background"
  ]
}
