{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "acquisition_calculation",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "calculation_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "calculation_type": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "input_metric": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "input_value": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "input_unit": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "formula": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "output_value": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "output_unit": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "calculation_replayed": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "limitation": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "linked_claim_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "human_review_required": {
      "type": [
        "boolean",
        "string",
        "null"
      ]
    },
    "claim_class": {
      "enum": [
        "source-backed fact",
        "evidence-supported inference",
        "assumption",
        "unknown",
        "human_review_required"
      ]
    },
    "PCE_status": {
      "enum": [
        "Certified",
        "Certified with Caveat",
        "Needs Human Review",
        "Not Certified",
        "Human Review Required",
        "Internal Trace Only"
      ]
    }
  },
  "required": [
    "calculation_id",
    "calculation_type"
  ]
