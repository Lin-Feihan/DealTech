{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "integration_risk",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "risk_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "risk_category": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "risk_description": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "buyer_impact": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "target_impact": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "likelihood": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "severity": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "mitigation_or_next_check": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "evidence_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "human_review_required": {
      "type": [
        "boolean",
        "string",
        "null"
      ]
    },
    "linked_claim_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "claim_class": {
      "enum": [
        "source-backed fact",
        "evidence-supported inference",
        "assumption",
        "unknown",
        "human_review_required"
      ]
    },
    "PCE_status": {
      "enum": [
        "Certified",
        "Certified with Caveat",
        "Needs Human Review",
        "Not Certified",
        "Human Review Required",
        "Internal Trace Only"
      ]
    }
  },
  "required": [
    "risk_id",
    "risk_category"
  ]
}
