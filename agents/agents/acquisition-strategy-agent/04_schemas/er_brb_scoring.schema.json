        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "business_risk_score": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "regulatory_risk_score": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "strategic_fit_score": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "data_quality_score": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "overall_ER_BRB_status": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "linked_evidence_ids": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "human_review_required": {
