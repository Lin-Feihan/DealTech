        "boolean",
        "string",
        "null"
      ]
    },
    "claim_class": {
      "enum": [
        "source-backed fact",
        "evidence-supported inference",
        "assumption",
        "unknown",
        "human_review_required"
      ]
    },
    "PCE_status": {
      "enum": [
        "Certified",
        "Certified with Caveat",
