{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "strategic_rationale",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "rationale_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "rationale_text": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "rationale_category": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "fact_or_inference": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "buyer_need": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "target_capability": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "evidence_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "confidence": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "limitation": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "human_review_required": {
      "type": [
        "boolean",
        "string",
        "null"
      ]
    },
    "linked_claim_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "claim_class": {
      "enum": [
        "source-backed fact",
        "evidence-supported inference",
        "assumption",
        "unknown",
        "human_review_required"
      ]
    },
    "PCE_status": {
      "enum": [
        "Certified",
        "Certified with Caveat",
        "Needs Human Review",
        "Not Certified",
        "Human Review Required",
        "Internal Trace Only"
      ]
    }
  },
  "required": [
    "rationale_id",
    "rationale_text"
  ]
}
