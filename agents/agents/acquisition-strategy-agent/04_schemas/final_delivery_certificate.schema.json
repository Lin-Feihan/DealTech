{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "final_delivery_certificate",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "case_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "view": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "overall_status": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "deliverable_claims": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "blocked_claims": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "human_review_required": {
      "type": [
        "boolean",
        "string",
        "null"
      ]
    },
    "certification_boundary": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "PCE_status": {
      "enum": [
        "Certified",
        "Certified with Caveat",
        "Needs Human Review",
        "Not Certified",
        "Human Review Required",
        "Internal Trace Only"
      ]
    },
    "claim_class": {
      "enum": [
        "source-backed fact",
        "evidence-supported inference",
        "assumption",
        "unknown",
        "human_review_required"
      ]
    }
  },
  "required": [
    "case_id",
    "view"
  ]
}
