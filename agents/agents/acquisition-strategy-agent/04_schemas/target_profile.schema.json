{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "target_profile",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "target_name": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "technology_direction": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "public_business_description": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "strategic_relevance": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "unknown_financial_information": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "evidence_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "claim_class": {
      "enum": [
        "source-backed fact",
        "evidence-supported inference",
        "assumption",
        "unknown",
        "human_review_required"
      ]
    },
    "human_review_required": {
      "type": [
        "boolean",
        "string",
        "null"
      ]
    },
    "PCE_status": {
      "enum": [
        "Certified",
        "Certified with Caveat",
        "Needs Human Review",
        "Not Certified",
        "Human Review Required",
        "Internal Trace Only"
      ]
    }
  },
  "required": [
    "target_name",
    "technology_direction"
  ]
}
