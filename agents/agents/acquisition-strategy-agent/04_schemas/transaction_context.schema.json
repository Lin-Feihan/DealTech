{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "transaction_context",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "buyer": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "target": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "transaction_type": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "known_public_facts": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "unknown_facts": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "deal_value": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "source_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "evidence_id": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "claim_class": {
      "enum": [
        "source-backed fact",
        "evidence-supported inference",
        "assumption",
        "unknown",
        "human_review_required"
      ]
    },
    "human_review_required": {
      "type": [
        "boolean",
        "string",
        "null"
      ]
    },
    "PCE_status": {
      "enum": [
        "Certified",
        "Certified with Caveat",
        "Needs Human Review",
        "Not Certified",
        "Human Review Required",
        "Internal Trace Only"
      ]
    }
  },
  "required": [
    "buyer",
    "target"
  ]
}
