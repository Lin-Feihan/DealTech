{
  "loop_policy_version": "2026-07-24",
  "agent_id": "acquisition_strategy_agent.buyer_side.v2",
  "max_iterations_default": 3,
  "max_iterations_hard_limit": 5,
  "loop_states": [
    "planned",
    "researching",
    "evidence_collected",
    "verification_failed",
    "gap_research_required",
    "certified",
    "certified_with_caveat",
    "human_review_required",
    "not_certified",
    "internal_trace_only",
    "terminated_quality_met",
    "terminated_budget_exhausted",
    "terminated_iteration_exhausted",
    "terminated_human_review_required"
  ],
  "quality_gate": {
    "all_material_decision_questions_covered": true,
    "no_critical_uncertified_claims_in_final_recommendation": true,
    "material_calculations_replayable": true,
    "source_quality_threshold_met": true,
    "material_conflicts_resolved_or_disclosed": true,
    "human_review_items_isolated_or_escalated": true
  },
  "research_gap_priority_order": [
    "final_recommendation_impact",
    "valuation_or_price_ceiling_impact",
    "deal_structure_or_financing_impact",
    "synergy_or_returns_impact",
    "risk_caveat_impact",
    "report_completeness_only"
  ],
  "stop_conditions": {
    "quality_met": "Proceed to report generation.",
    "max_iterations_reached": "Stop automatic execution and emit restricted output or research gap memo.",
    "budget_exhausted": "Stop automatic execution and emit restricted output or research gap memo.",
    "beyond_automated_judgment": "Escalate to human review."
  },
  "restricted_output_allowed": true
}
