{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealtech.local/v2/schemas/report_manifest.schema.json",
  "title": "Buyer Report Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "analysis_engine_version", "overall_status", "recommendation", "sections"],
  "properties": {
    "case_id": {"type": "string"},
    "analysis_engine_version": {"type": "string"},
    "overall_status": {"type": "string"},
    "recommendation": {"type": "string"},
    "sections": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "number", "title", "basis_ids", "model_refs"],
        "properties": {
          "section_id": {"type": "string"},
          "number": {"type": "integer"},
          "title": {"type": "string"},
          "basis_ids": {"type": "array", "items": {"type": "string"}},
          "model_refs": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
