{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealtech.local/v2/schemas/analysis_package.schema.json",
  "title": "Analysis-First Buyer Acquisition Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_engine_version",
    "case_id",
    "report_metadata",
    "certification_status",
    "recommendation",
    "recommendation_analysis",
    "facts",
    "assumptions",
    "method_selection",
    "alternatives",
    "models",
    "sections",
    "research_gaps",
    "human_review_items",
    "quality_control",
    "report_forbidden_markers"
  ],
  "properties": {
    "analysis_engine_version": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "report_metadata": {
      "type": "object",
      "required": ["case_id", "title", "as_of_date", "transaction_state", "decision_mandate", "evidence_boundary"]
    },
    "certification_status": {"type": "string", "minLength": 1},
    "recommendation": {
      "type": "string",
      "enum": ["Proceed", "Proceed with Conditions", "Renegotiate", "Defer", "Walk Away"]
    },
    "recommendation_analysis": {"type": "object"},
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/analysisBasis"}
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/analysisBasis"}
    },
    "method_selection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["analysis_area", "model_id", "method", "rationale", "scenario_policy", "basis_ids"]
      }
    },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "object", "required": ["option", "control", "capital_at_risk", "advantage", "drawback", "current_view"]}
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["model_type", "valuation_date", "currency", "discount_rate", "method", "scenarios", "model_limitations"],
        "properties": {
          "model_type": {"type": "string", "enum": ["dcf", "rnpv"]},
          "discount_rate": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
          "scenarios": {"type": "array", "minItems": 1}
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {"$ref": "section_analysis.schema.json"}
    },
    "research_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "decision_effect"],
        "properties": {
          "question": {"type": "string", "minLength": 1},
          "decision_effect": {"type": "string", "minLength": 1}
        }
      }
    },
    "human_review_items": {"type": "array", "items": {"type": "string"}},
    "quality_control": {
      "type": "object",
      "required": ["passed", "checks", "note"],
      "properties": {
        "passed": {"type": "boolean"},
        "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "note": {"type": "string"}
      }
    },
    "report_forbidden_markers": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "analysisBasis": {
      "type": "object",
      "required": ["id", "statement", "evidence_class"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "evidence_class": {"type": "string", "minLength": 1}
      }
    }
  }
}
