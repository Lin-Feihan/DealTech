{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealtech.local/v2/schemas/evidence.schema.json",
  "title": "Evidence Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "source_id", "source_type", "evidence_type", "content", "retrieved_at", "reliability"],
  "properties": {
    "evidence_id": {"type": "string"},
    "source_id": {"type": "string"},
    "source_title": {"type": "string"},
    "source_url_or_path": {"type": "string"},
    "source_type": {"type": "string", "enum": ["regulatory_filing", "annual_report", "quarterly_report", "company_website", "investor_material", "market_data", "news", "industry_report", "internal_material", "analyst_estimate", "other"]},
    "evidence_type": {"type": "string", "enum": ["quoted_text", "numeric_data", "table", "calculation_input", "management_statement", "market_observation", "analyst_estimate", "other"]},
    "content": {"type": "string"},
    "retrieved_at": {"type": "string"},
    "as_of_date": {"type": "string"},
    "reliability": {"type": "string", "enum": ["high", "medium", "low", "unknown"]},
    "limitations": {"type": "string"},
    "linked_claim_ids": {"type": "array", "items": {"type": "string"}}
  }
}
