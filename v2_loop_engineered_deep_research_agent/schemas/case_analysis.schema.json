{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealtech.local/v2/schemas/case_analysis.schema.json",
  "title": "Authoritative Buyer Case Analysis Input",
  "type": "object",
  "required": [
    "report_metadata",
    "recommendation",
    "facts",
    "assumptions",
    "method_selection",
    "models",
    "alternatives",
    "chapters",
    "research_gaps",
    "human_review_items"
  ],
  "properties": {
    "report_metadata": {"type": "object"},
    "recommendation": {"type": "object"},
    "facts": {"type": "array", "minItems": 1},
    "assumptions": {"type": "array", "minItems": 1},
    "method_selection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["analysis_area", "model_id", "method", "rationale", "scenario_policy", "basis_ids"],
        "properties": {
          "analysis_area": {"type": "string", "minLength": 1},
          "model_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "method": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "scenario_policy": {"type": "string", "enum": ["single_case", "downside_base_upside"]},
          "basis_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "models": {"type": "object", "minProperties": 1},
    "alternatives": {"type": "array", "minItems": 2},
    "chapters": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "section_analysis.schema.json"}},
    "research_gaps": {"type": "array"},
    "human_review_items": {"type": "array"}
  }
}
