{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealtech.local/v2/schemas/mandate.schema.json",
  "title": "Mandate",
  "type": "object",
  "additionalProperties": false,
  "required": ["mandate_id", "agent_id", "perspective", "transaction", "decision_questions", "output_requirements", "governance"],
  "properties": {
    "mandate_id": {"type": "string"},
    "agent_id": {"type": "string"},
    "perspective": {"type": "string", "enum": ["buyer", "target_seller"]},
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buyer_name", "target_name"],
      "properties": {
        "buyer_name": {"type": "string"},
        "target_name": {"type": "string"},
        "transaction_type": {"type": "string"},
        "ownership_percentage_to_acquire": {"type": "string"},
        "transaction_background": {"type": "string"},
        "analysis_date": {"type": "string"},
        "report_currency": {"type": "string"},
        "markets_and_jurisdictions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "decision_questions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evidence_requirements": {"type": "array", "items": {"type": "string"}},
    "internal_materials": {"type": "array", "items": {"type": "string"}},
    "output_requirements": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_iterations", "human_review_required_for"],
      "properties": {
        "max_iterations": {"type": "integer", "minimum": 1},
        "time_budget_minutes": {"type": "integer", "minimum": 1},
        "allow_restricted_output": {"type": "boolean"},
        "human_review_required_for": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
