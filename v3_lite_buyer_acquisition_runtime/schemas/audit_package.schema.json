{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealtech.local/schemas/v3-lite/audit_package.schema.json",
  "title": "V3-Lite Professional Report Audit Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "generated_artifact",
    "stage",
    "source_bounded",
    "created_at",
    "created_from_report_manifest_id",
    "created_from_analysis_package_id",
    "created_from_certification_result_id",
    "created_from_claim_evidence_graph_id",
    "created_from_evidence_repository_id",
    "report_generation_allowed",
    "recommendation_allowed",
    "report_section_trace",
    "source_citation_table",
    "excluded_claims",
    "caveat_map",
    "human_review_summary",
    "recommendation_gate_record",
    "audit_summary"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "generated_artifact": {"type": "string", "const": "audit_package.json"},
    "stage": {"type": "string", "const": "Step6A_professional_report_audit_package"},
    "source_bounded": {"type": "boolean", "const": true},
    "created_at": {"type": "string", "minLength": 1},
    "created_from_report_manifest_id": {"type": "string", "minLength": 1},
    "created_from_analysis_package_id": {"type": "string", "minLength": 1},
    "created_from_certification_result_id": {"type": "string", "minLength": 1},
    "created_from_claim_evidence_graph_id": {"type": "string", "minLength": 1},
    "created_from_evidence_repository_id": {"type": "string", "minLength": 1},
    "report_generation_allowed": {"type": "boolean"},
    "recommendation_allowed": {"type": "boolean"},
    "report_section_trace": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "report_section_trace.schema.json"}
    },
    "source_citation_table": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_title",
          "source_tier",
          "evidence_record_ids",
          "claim_ids",
          "report_section_ids"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_title": {"type": "string"},
          "source_tier": {"type": "string"},
          "evidence_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "report_section_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "excluded_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "claim_type", "certification_status", "exclusion_reason", "related_source_gap_ids"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "claim_type": {"type": "string"},
          "certification_status": {"type": "string"},
          "exclusion_reason": {"type": "string", "minLength": 1},
          "related_source_gap_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "caveat_map": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caveat_id", "caveat_text", "related_claim_ids", "report_section_ids"],
        "properties": {
          "caveat_id": {"type": "string", "minLength": 1},
          "caveat_text": {"type": "string", "minLength": 1},
          "related_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "report_section_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "human_review_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_review_required", "human_review_item_count", "human_review_items"],
      "properties": {
        "human_review_required": {"type": "boolean"},
        "human_review_item_count": {"type": "integer", "minimum": 0},
        "human_review_items": {"type": "array", "items": {"type": "object"}}
      }
    },
    "recommendation_gate_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation_allowed", "source", "blocked_claim_ids", "blocking_reasons", "decision_artifact_required_for_recommendation"],
      "properties": {
        "recommendation_allowed": {"type": "boolean"},
        "source": {"type": "string", "minLength": 1},
        "blocked_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "blocking_reasons": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "decision_artifact_required_for_recommendation": {"type": "boolean", "const": true}
      }
    },
    "audit_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_section_count",
        "traced_claim_count",
        "traced_evidence_record_count",
        "traced_source_count",
        "excluded_claim_count",
        "caveat_count",
        "notes"
      ],
      "properties": {
        "report_section_count": {"type": "integer", "minimum": 0},
        "traced_claim_count": {"type": "integer", "minimum": 0},
        "traced_evidence_record_count": {"type": "integer", "minimum": 0},
        "traced_source_count": {"type": "integer", "minimum": 0},
        "excluded_claim_count": {"type": "integer", "minimum": 0},
        "caveat_count": {"type": "integer", "minimum": 0},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
