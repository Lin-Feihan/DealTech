{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealtech.local/schemas/v3-lite/analysis_package.schema.json",
  "title": "V3-Lite Evidence-Bounded Deal Analysis Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "generated_artifact",
    "stage",
    "source_bounded",
    "evidence_coverage_status",
    "created_from_certification_result_id",
    "created_from_claim_evidence_graph_id",
    "created_from_evidence_repository_id",
    "created_at",
    "analysis_readiness_status",
    "recommendation_allowed",
    "final_report_allowed",
    "supporting_claim_ids",
    "consumed_certified_claim_ids",
    "consumed_caveated_claim_ids",
    "excluded_claim_ids",
    "exclusion_reasons",
    "preserved_caveats",
    "recommendation_gate_status",
    "report_gate_status",
    "analysis_sections",
    "blocked_analysis_items",
    "caveats",
    "human_review_items",
    "next_action"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "generated_artifact": {"type": "string", "const": "analysis_package.json"},
    "stage": {"type": "string", "const": "M6_evidence_bounded_deal_analysis"},
    "source_bounded": {"type": "boolean", "const": true},
    "evidence_coverage_status": {"type": "string", "minLength": 1},
    "created_from_certification_result_id": {"type": "string", "minLength": 1},
    "created_from_claim_evidence_graph_id": {"type": "string", "minLength": 1},
    "created_from_evidence_repository_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "analysis_readiness_status": {
      "type": "string",
      "enum": [
        "ready_for_limited_analysis",
        "limited_by_repair_required",
        "blocked_by_certification_failure",
        "human_review_required"
      ]
    },
    "recommendation_allowed": {"type": "boolean"},
    "final_report_allowed": {"type": "boolean"},
    "supporting_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "consumed_certified_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "consumed_caveated_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "excluded_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "exclusion_reasons": {"type": "array", "items": {"type": "object"}},
    "preserved_caveats": {"type": "array", "items": {"type": "object"}},
    "recommendation_gate_status": {"type": "string", "enum": ["allowed", "blocked"]},
    "report_gate_status": {"type": "string", "enum": ["allowed", "blocked"]},
    "analysis_sections": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_id",
          "title",
          "section_status",
          "summary",
          "included_claim_ids",
          "supporting_claim_ids",
          "excluded_claim_ids",
          "supporting_evidence_record_ids",
          "findings",
          "caveats"
        ],
        "properties": {
          "section_id": {
            "type": "string",
            "enum": [
              "transaction_background_and_terms",
              "strategic_rationale_and_alternatives",
              "target_business_quality",
              "market_and_competitive_position",
              "valuation_deal_structure_and_returns",
              "synergy_and_value_creation",
              "financing_payment_mechanics_and_value_transfer",
              "legal_regulatory_and_diligence_risks",
              "integration_and_operational_risks",
              "source_gaps_and_human_review",
              "decision_readiness"
            ]
          },
          "title": {"type": "string", "minLength": 1},
          "section_status": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "included_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "supporting_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "excluded_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "supporting_evidence_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "findings": {"type": "array", "items": {"type": "object"}},
          "caveats": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "blocked_analysis_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "blocked_item_id",
          "blocked_topic",
          "reason",
          "related_research_gap_ids",
          "required_repair_target",
          "can_appear_in_final_report"
        ],
        "properties": {
          "blocked_item_id": {"type": "string", "minLength": 1},
          "blocked_topic": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "related_research_gap_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "required_repair_target": {"type": "string", "minLength": 1},
          "can_appear_in_final_report": {"type": "boolean", "const": false}
        }
      }
    },
    "caveats": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "human_review_items": {"type": "array", "items": {"type": "object"}},
    "next_action": {"type": "string", "minLength": 1}
  }
}
