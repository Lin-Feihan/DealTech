{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealtech.local/schemas/v3-lite/targeted_source_discovery_plan.schema.json",
  "title": "V3-Lite Targeted Source Discovery Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "generated_artifact",
    "stage",
    "created_from_repair_plan_id",
    "created_at",
    "target_state",
    "targeted_source_needs",
    "targeted_search_queries",
    "expected_retrieval_outputs",
    "blocked_or_deferred_repairs"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "generated_artifact": {"type": "string", "const": "targeted_source_discovery_plan.json"},
    "stage": {"type": "string", "const": "M5_1_repair_loop_execution"},
    "created_from_repair_plan_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "target_state": {"type": "string", "const": "M2_source_retrieval"},
    "targeted_source_needs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targeted_source_need_id",
          "original_research_gap_id",
          "related_claim_ids",
          "missing_source_need_ids",
          "missing_source_description",
          "required_source_types",
          "preferred_source_owners",
          "source_tier_required",
          "priority",
          "purpose",
          "expected_downstream_update"
        ],
        "properties": {
          "targeted_source_need_id": {"type": "string", "minLength": 1},
          "original_research_gap_id": {"type": "string", "minLength": 1},
          "related_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "missing_source_need_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "missing_source_description": {"type": "string", "minLength": 1},
          "required_source_types": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "preferred_source_owners": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "source_tier_required": {"type": "string", "minLength": 1},
          "priority": {"type": "string", "enum": ["low", "medium", "high"]},
          "purpose": {"type": "string", "minLength": 1},
          "expected_downstream_update": {"type": "string", "minLength": 1}
        }
      }
    },
    "targeted_search_queries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query_id",
          "query_text",
          "target_source_need_id",
          "intended_provider",
          "expected_source_owner",
          "expected_source_tier",
          "must_not_use_sources"
        ],
        "properties": {
          "query_id": {"type": "string", "minLength": 1},
          "query_text": {"type": "string", "minLength": 1},
          "target_source_need_id": {"type": "string", "minLength": 1},
          "intended_provider": {"type": "string", "minLength": 1},
          "expected_source_owner": {"type": "string", "minLength": 1},
          "expected_source_tier": {"type": "string", "minLength": 1},
          "must_not_use_sources": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "expected_retrieval_outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "blocked_or_deferred_repairs": {"type": "array", "items": {"type": "object"}}
  }
}
