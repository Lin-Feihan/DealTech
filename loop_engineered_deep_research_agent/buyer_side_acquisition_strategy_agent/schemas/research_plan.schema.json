{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealtech.local/schemas/v3-lite/research_plan.schema.json",
  "title": "Buyer-Side Acquisition Strategy Agent Buyer Acquisition Research Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "research_objective",
    "key_questions",
    "workstreams",
    "evidence_requirements",
    "expected_artifacts",
    "verification_targets",
    "open_questions"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "research_objective": {
      "type": "string",
      "minLength": 1
    },
    "key_questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workstreams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "objective", "questions", "planned_artifacts"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "planned_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "source_pack_reference"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_pack_reference": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "enum": ["mandate.json", "research_plan.json"]
      }
    },
    "verification_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "reason"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

