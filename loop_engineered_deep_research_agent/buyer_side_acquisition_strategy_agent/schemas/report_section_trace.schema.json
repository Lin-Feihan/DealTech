{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealtech.local/schemas/v3-lite/report_section_trace.schema.json",
  "title": "Buyer-Side Acquisition Strategy Agent Report Section Trace Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_section_id",
    "report_section_title",
    "source_analysis_section_ids",
    "used_claim_ids",
    "used_evidence_record_ids",
    "used_source_ids",
    "required_caveats",
    "excluded_claim_ids",
    "trace_notes"
  ],
  "properties": {
    "report_section_id": {"type": "string", "minLength": 1},
    "report_section_title": {"type": "string", "minLength": 1},
    "source_analysis_section_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "used_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "used_evidence_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "used_source_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "required_caveats": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "excluded_claim_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "trace_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
